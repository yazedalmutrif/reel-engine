{
  "type": "object",
  "additionalProperties": false,
  "required": ["occasions"],
  "properties": {
    "occasions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "ideas"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "ideas": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "hook_line", "beats", "shot_note", "length_s"],
              "properties": {
                "title": {"type": "string", "minLength": 2, "maxLength": 120},
                "hook_line": {"type": "string", "minLength": 2, "maxLength": 160},
                "beats": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 2, "maxLength": 200}},
                "shot_note": {"type": "string", "maxLength": 240},
                "length_s": {"type": "integer", "minimum": 20, "maximum": 90}
              }
            }
          }
        }
      }
    }
  }
}
