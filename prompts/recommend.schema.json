{
  "type": "object",
  "additionalProperties": false,
  "required": ["ideas", "occasions", "summary"],
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "hook_line", "format", "length", "best_time", "why"],
        "properties": {
          "topic": {"type": "string", "minLength": 2, "maxLength": 120},
          "hook_line": {"type": "string", "minLength": 2, "maxLength": 160},
          "format": {"type": "string", "maxLength": 60},
          "length": {"type": "string", "maxLength": 40},
          "best_time": {"type": "string", "maxLength": 40},
          "why": {"type": "string", "maxLength": 240}
        }
      }
    },
    "occasions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "angle"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "angle": {"type": "string", "maxLength": 240}
        }
      }
    },
    "summary": {"type": "string", "maxLength": 600}
  }
}
