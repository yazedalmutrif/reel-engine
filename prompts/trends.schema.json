{
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "searched"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "why_it_matters", "source_url", "source_name", "published_date", "topic", "episode_idea"],
        "properties": {
          "title": {"type": "string", "maxLength": 160},
          "summary": {"type": "string", "maxLength": 500},
          "why_it_matters": {"type": "string", "maxLength": 300},
          "source_url": {"type": "string", "pattern": "^https://", "maxLength": 500},
          "source_name": {"type": "string", "maxLength": 120},
          "published_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "topic": {"type": "string", "enum": ["ai_tools", "job_hunt", "graduate_programs", "saudi_market", "reels_format", "other"]},
          "episode_idea": {"type": "string", "maxLength": 240}
        }
      }
    },
    "searched": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 20}
  }
}
