      "status": "logging"
    },
    {
      "id": "H7",
      "text": "Publishing method: API vs in-app.",
      "metric": "reach",
      "dimension": null,
      "status": "parked"
    },
    {
      "id": "H8",
      "text": "Format: list vs single-tip explainer vs myth-bust on the same topic.",
      "metric": "composite",
      "dimension": "format",
      "status": "next"
    }
  ],
