{
  "version": 1,
  "created_at": "2026-01-01",
  "source": "brand.example/playbook_seed.md (generic example starting rules)",
  "summary": "Example starting playbook: generic rules, every arm starts even except a mild prior on 46-60 s. The account's own Insights decide from here.",
  "rules": [
    {
      "id": "R1",
      "text": "Burned-in captions, and the first 3 s name the problem or the payoff. No slow intro.",
      "evidence": "OFFICIAL",
      "locked": false
    },
    {
      "id": "R2",
      "text": "Default length 45-75 s; avoid very short or very long reels.",
      "evidence": "OBSERVED",
      "locked": false
    },
    {
      "id": "R3",
      "text": "Keep everything under 3 min (the engine caps at 90 s).",
      "evidence": "OBSERVED",
      "locked": false
    },
    {
      "id": "R4",
      "text": "3-5 hashtags, never more than 5, topic-specific.",
      "evidence": "OFFICIAL",
      "locked": true
    },
    {
      "id": "R5",
      "text": "Put real keywords (Arabic + English tool names) in the caption and on-screen text.",
      "evidence": "OFFICIAL",
      "locked": false
    },
    {
      "id": "R6",
      "text": "Only the creator's own filmed footage. No reposts, no watermarks.",
      "evidence": "OFFICIAL",
      "locked": true
    },
    {
      "id": "R7",
      "text": "No engagement bait.",
      "evidence": "brand rule",
      "locked": true
    },
    {
      "id": "R8",
      "text": "No guaranteed outcomes about jobs, salaries or AI results.",
      "evidence": "OFFICIAL",
      "locked": true
    },
    {
      "id": "R9",
      "text": "Check Account Status weekly.",
      "evidence": "OFFICIAL",
      "locked": false
    },
    {
      "id": "R10",
      "text": "No Trial Reels until 1,000 followers.",
      "evidence": "OBSERVED",
      "locked": true
    },
    {
      "id": "R11",
      "text": "Cover: 1080x1920 with the face and text in the central ~1:1.",
      "evidence": "OBSERVED",
      "locked": false
    },
    {
      "id": "R12",
      "text": "Post consistently, but never sacrifice quality to hit a quota.",
      "evidence": "OFFICIAL",
      "locked": true
    },
    {
      "id": "R13",
      "text": "Audio is baked into the file. Check the live publishing quota.",
      "evidence": "OBSERVED",
      "locked": true
    },
    {
      "id": "R14",
      "text": "Don't assume API posts get less reach; let the data decide.",
      "evidence": "FOLKLORE",
      "locked": false
    },
    {
      "id": "R15",
      "text": "'Best time' tables are starting guesses; the account's Insights decide.",
      "evidence": "OFFICIAL",
      "locked": false
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "text": "Hook style: problem vs bold claim / myth-bust vs list (plus question, story, POV/before-after).",
      "metric": "reels_skip_rate, watch_ratio",
      "dimension": "hook_type",
      "status": "running"
    },
    {
      "id": "H2",
      "text": "Length band: 20-30 s vs 31-45 s vs 46-60 s vs 61-90 s.",
      "metric": "watch_ratio, shares_per_reach",
      "dimension": "duration_band",
      "status": "running"
    },
    {
      "id": "H3",
      "text": "Posting slot: weekday vs weekend x 13:30 / 18:30 / 21:30 / 22:30.",
      "metric": "composite",
      "dimension": "slot",
      "status": "running"
    },
    {
      "id": "H4",
      "text": "Caption style: natural sentences with keywords vs short caption with keywords on screen.",
